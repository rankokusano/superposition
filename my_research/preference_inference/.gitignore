# large datasets
data/data/

# model checkpoints (large .pth files)
data/result/*/0/model/
data/result/*/0/test/*/save/
data/result/*/0/test/

# v7: never track new binary outputs (existing tracked .pth/.h5 are left as is)
data/result/v7_irl/**/*.h5
data/result/v7_irl/**/*.npz
data/result/v7_irl/**/*.pth

data/model/v7/

# RL model files (keep data/model/ — it's 30MB and needed to reproduce)
# data/model/

__pycache__/
*.pyc

# v10: never track binary outputs
data/model/v10/
data/result/v10_swap/**/*.h5
data/result/v10_swap/**/*.npz
data/result/v10_swap/**/*.pth
data/result/v10_swapmix_*/
data/result/v10_b3_*/*/model/
data/result/v10_b3_*/*/test/

# v11: never track binary outputs (data/data/ is already ignored above)
data/result/v11/**/*.h5
data/result/v11/**/*.npz
data/result/v11/**/*.pth
data/result/v11_*/*/model/
data/result/v11_*/*/test/
data/result/v11_*/*/save/

# v15: never track binary outputs (data/data/ is already ignored above)
data/result/v15/**/*.h5
data/result/v15/**/*.npz
data/result/v15/**/*.pth
